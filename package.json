{
	"name": "pureref-viewer",
	"version": "0.1.0",
	"description": "View PureRef reference boards (.pur) inside Obsidian and embed them in notes.",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "node --test \"test/**/*.test.ts\"",
		"install-vault": "node scripts/install-vault.mjs",
		"version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": ["obsidian", "pureref"],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "22.20.1",
		"esbuild": "0.25.5",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"obsidian": "1.13.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.70.0"
	}
}
